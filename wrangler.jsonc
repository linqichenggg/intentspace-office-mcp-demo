{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intentspace-office-demo",
  "main": "worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "intentspace.linqicheng.uk", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "OFFICE_WORKSPACES", "class_name": "OfficeWorkspace" }]
  },
  "migrations": [{ "tag": "office-v1", "new_sqlite_classes": ["OfficeWorkspace"] }],
  "assets": {
    "directory": "./.build/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "rules": [{ "type": "Text", "globs": ["**/*.csv"], "fallthrough": true }],
  "build": { "command": "node build-assets.js" },
  "observability": { "enabled": false }
}
